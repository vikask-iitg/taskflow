{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow - a full-stack to-do application (Node.js, Express, MongoDB, Vanilla JS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server.js --watch-path=config --watch-path=lib --watch-path=middleware --watch-path=models --watch-path=routes server.js",
    "dev:memory": "MONGODB_URI=memory npm run dev"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
