PORT=3000
# Use a real MongoDB connection string, or "memory" for a throwaway in-memory database (dev only)
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Public address of the app, used in password reset links
APP_URL=http://localhost:3000
# Email for password reset links (optional). Without SMTP_HOST the link is printed in the server log.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TaskFlow <no-reply@taskflow.local>
